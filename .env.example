# Copy to .env and fill in. Never commit .env.

# --- Controller -----------------------------------------------------------
# Admin token for the dashboard, REST API and MCP. Generate: openssl rand -hex 24
DBROWSER_API_TOKEN=change-me-to-a-long-random-string
# Optional per-agent MCP tokens (agent can only see/drive its own browser):
#   DBROWSER_AGENT_TOKENS=grok-bot:<token>,research-agent:<token>
DBROWSER_AGENT_TOKENS=
DBROWSER_BROWSER_IMAGE=disposable-browser/browser:dev
DBROWSER_MAX_SESSIONS=10
DBROWSER_DEFAULT_TTL_SECONDS=3600
DBROWSER_MAX_TTL_SECONDS=86400
# Host used in viewer/CDP URLs handed back to clients
DBROWSER_PUBLIC_HOST=localhost
# Interface session ports are published on (keep 127.0.0.1 unless you know why)
DBROWSER_PUBLISH_BIND=127.0.0.1
DBROWSER_MEMORY_LIMIT=2g
DBROWSER_SHM_SIZE=1g
DBROWSER_CPUS=1.0
# Optional DNS-over-HTTPS for every session, e.g. https://dns.quad9.net/dns-query
DBROWSER_DOH_TEMPLATE=

# Linux: docker group id so the non-root controller can use the socket
#   getent group docker | cut -d: -f3
DOCKER_GID=0

# --- Per-session egress / exposure ----------------------------------------
# WireGuard: drop <profile>.conf files into ./wireguard/ (git-ignored)
# Tailscale: use an EPHEMERAL, pre-approved auth key so nodes vanish with sessions
DBROWSER_TAILSCALE_AUTHKEY=
# Cloudflare: empty token = free quick tunnel (random trycloudflare.com URL)
DBROWSER_CLOUDFLARE_TUNNEL_TOKEN=
DBROWSER_CLOUDFLARE_TUNNEL_HOSTNAME=

# --- Optional compose sidecars exposing the controller itself --------------
CLOUDFLARE_TUNNEL_TOKEN=
TS_AUTHKEY=
